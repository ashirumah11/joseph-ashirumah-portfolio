# ==============================================================================
# Joseph Ashirumah - Full-Stack Software Engineer Portfolio
# Environment Configuration Template
# Duplicate this file as .env and adjust values for your environment.
# ==============================================================================

# Core Django Security Settings
SECRET_KEY=your-secure-random-secret-key-here-min-50-characters
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0,.onrender.com,.railway.app
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,https://yourdomain.com

# Database Connection (Defaults to local SQLite if omitted)
# For production PostgreSQL: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=sqlite:///db.sqlite3

# Email Dispatch Configuration (Optional - Console backend used by default if empty)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password
DEFAULT_FROM_EMAIL=Joseph Ashirumah <noreply@yourdomain.com>
CONTACT_EMAIL=joseph.ashirumah@example.com

# Production SSL & Cookie Hardening (Set to True in production with HTTPS)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
